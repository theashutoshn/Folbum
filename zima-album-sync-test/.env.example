# Required. Generate a strong password and put it in .env. Example: python3 -c 'import secrets;print(secrets.token_urlsafe(24))'
APP_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
# Set true when the app is accessed only through an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false
# demo: safe sample gallery; live: connect to ZimaOS Photos APIs.
ZIMA_MODE=demo
# App timestamps and Last sync display; use your local IANA time zone.
APP_TIMEZONE=Asia/Kolkata
# Add a NAS address in the Connection page after starting in live mode.
# Even in live mode, POST /api/sync is blocked until explicitly enabled.
ENABLE_LIVE_WRITES=false
# Default binds only to local loopback. Set BIND_IP=0.0.0.0 only on trusted LAN.
BIND_IP=0.0.0.0
APP_PORT=8765

# Optional read-only disk comparison. Use with compose.disk.yaml in live mode.
# HOST_GALLERY_PATH is the NAS host directory for the selected Photos source.
# PHOTOS_SOURCE_PATH is the source path shown in this app's Sync settings.
HOST_GALLERY_PATH=
PHOTOS_SOURCE_PATH=
