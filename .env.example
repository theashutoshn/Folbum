# Required. Generate a strong password and put it in .env. Example: python3 -c 'import secrets;print(secrets.token_urlsafe(24))'
APP_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
# demo: safe sample gallery; live: connect to ZimaOS Photos APIs.
ZIMA_MODE=demo
# Configure your ZimaOS URL in the app after opening it.
ZIMA_URL=
# Even in live mode, POST /api/sync is blocked until explicitly enabled.
ENABLE_LIVE_WRITES=false
# Default binds only to local loopback. Set BIND_IP=0.0.0.0 only on trusted LAN.
BIND_IP=127.0.0.1
APP_PORT=8765
