# Create your Folbum account in the first-run popup.
# Set true when the app is accessed only through an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false
# App timestamps and Last sync display; use your local IANA time zone.
APP_TIMEZONE=Asia/Kolkata
# Add a NAS address in the Connection page after starting Folbum.
# Bind only to local loopback for development. Set BIND_IP=0.0.0.0 only on a trusted LAN.
BIND_IP=127.0.0.1
APP_PORT=8765

# Optional read-only disk comparison. Use with compose.disk.yaml.
# HOST_GALLERY_PATH is the NAS host directory for the selected Photos source.
# PHOTOS_SOURCE_PATH is the source path shown in this app's Sync tab.
HOST_GALLERY_PATH=
PHOTOS_SOURCE_PATH=
